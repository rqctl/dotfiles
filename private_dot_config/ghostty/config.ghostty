theme = Catppuccin Mocha
font-size = 10
window-theme = dark

bell-features = no-title
window-padding-color = extend

scrollback-limit = 100000000
confirm-close-surface = true
copy-on-select = clipboard

# Sessions -> tabs
keybind = ctrl+t=new_tab
keybind = ctrl+n=new_window
keybind = ctrl+w=close_surface
keybind = ctrl+page_down=next_tab
keybind = ctrl+page_up=previous_tab
keybind = ctrl+shift+page_down=move_tab:1
keybind = ctrl+shift+page_up=move_tab:-1

keybind = f11=toggle_fullscreen
keybind = ctrl+enter=unbind

# digit_N = physical key, so this works on AZERTY without shift
keybind = ctrl+digit_1=goto_tab:1
keybind = ctrl+digit_2=goto_tab:2
keybind = ctrl+digit_3=goto_tab:3
keybind = ctrl+digit_4=goto_tab:4
keybind = ctrl+digit_5=goto_tab:5
keybind = ctrl+digit_6=goto_tab:6
keybind = ctrl+digit_7=goto_tab:7
keybind = ctrl+digit_8=goto_tab:8
keybind = ctrl+digit_9=goto_tab:9


# Splits
keybind = ctrl+alt+r=new_split:right
keybind = ctrl+alt+d=new_split:down
keybind = alt+arrow_up=goto_split:up
keybind = alt+arrow_down=goto_split:down
keybind = alt+arrow_left=goto_split:left
keybind = alt+arrow_right=goto_split:right
keybind = shift+alt+arrow_up=resize_split:up,20
keybind = shift+alt+arrow_down=resize_split:down,20
keybind = shift+alt+arrow_left=resize_split:left,20
keybind = shift+alt+arrow_right=resize_split:right,20

keybind = shift+enter=text:\x1b\r
