## -----  SSH  -----

# Cache "$@" stdout under ~/.cache/gssh; listing instances is slow.
# Caches only a successful, non-empty run — an unauthenticated gcloud would
# otherwise pin an empty list for the day. A stale cache is served at once and
# refreshed in the background.
_gssh_cached() {
    local key="$1"; shift
    local cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/gssh"
    local cache_file="$cache_dir/$key" tmp
    local cache_duration_s=86400
    mkdir -p "$cache_dir"
    tmp="$cache_file.$$"

    if [[ -s "$cache_file" ]]; then
        command cat "$cache_file"
        if (( $(date +%s) - $(date +%s -r "$cache_file") > $cache_duration_s )); then
            { "$@" > "$tmp" 2>/dev/null && [[ -s "$tmp" ]] && command mv "$tmp" "$cache_file" \
                || command rm -f "$tmp"; } &!
        fi
        return 0
    fi

    if "$@" > "$tmp" && [[ -s "$tmp" ]]; then
        command mv "$tmp" "$cache_file"
        command cat "$cache_file"
    else
        command rm -f "$tmp"
        return 1
    fi
}

# Direct REST calls: `gcloud ... list` costs seconds of CLI startup.
_gssh_api() {
    local token; token=$(gcloud auth print-access-token 2>/dev/null) || return 1
    curl -sf -H "Authorization: Bearer $token" "$1"
}

# Every instance of the org as "name zone project state", from one Cloud Asset search.
# The index lags new VMs by a few minutes; see _gssh_list_project_instances.
_gssh_list_instances() {
    setopt local_options pipefail
    local org={{ .org.gcpOrgId | quote }} url page="" resp out=""
    [[ -z $org ]] && { echo "gssh: set org.gcpOrgId in chezmoi.toml." >&2; return 1; }
    while :; do
        url="https://cloudasset.googleapis.com/v1/organizations/${org}:searchAllResources?assetTypes=compute.googleapis.com/Instance&readMask=name,state&pageSize=500"
        [[ -n $page ]] && url+="&pageToken=$page"
        resp=$(_gssh_api "$url") || return 1
        out+=$(jq -r '.results[]? | (.name | capture("projects/(?<p>[^/]+)/zones/(?<z>[^/]+)/instances/(?<n>.+)$")) + {s: .state} | "\(.n) \(.z) \(.p) \(.s)"' <<< "$resp")$'\n'
        page=$(jq -r '.nextPageToken // empty' <<< "$resp")
        [[ -z $page ]] && break
    done
    sed '/^$/d' <<< "$out"
}

# Same format for one project, straight from the Compute API (no indexing lag).
_gssh_list_project_instances() {
    setopt local_options pipefail
    _gssh_api "https://compute.googleapis.com/compute/v1/projects/$1/aggregated/instances?maxResults=500&fields=items/*/instances(name,zone,status)" \
        | jq -r --arg p "$1" '.items[]?.instances[]? | "\(.name) \(.zone | split("/") | last) \($p) \(.status)"'
}

# Swap one project's lines in the cache for live data.
_gssh_refresh_project() {
    local project="$1" cache_file="${XDG_CACHE_HOME:-$HOME/.cache}/gssh/instances" fresh others
    fresh=$(_gssh_list_project_instances "$project") || return 1
    others=$(_gssh_cached instances _gssh_list_instances) || return 1
    { awk -v p="$project" '$3 != p' <<< "$others"; print -r -- "$fresh"; } \
        | sed '/^$/d' > "$cache_file.$$" \
        && command mv "$cache_file.$$" "$cache_file"
}

_gssh_usage() {
    echo "Usage: gssh [-r] [-f <project>]"
    echo "  -r            Refresh the whole instance cache (Cloud Asset API)"
    echo "  -f <project>  Refresh one project live (Compute API), for a just-created VM"
    echo "  -h            Show this help message"
}

# Usage: gssh [-r] [-f <project>] — pick an instance, then SSH in through IAP.
gssh() {
    local refresh=0 fresh_project="" opt OPTIND=1
    while getopts "f:rh" opt; do
        case $opt in
            f) fresh_project=$OPTARG ;;
            r) refresh=1 ;;
            h) _gssh_usage; return 0 ;;
            *) _gssh_usage; return 1 ;;
        esac
    done
    (( refresh )) && command rm -f "${XDG_CACHE_HOME:-$HOME/.cache}/gssh/instances"
    if [[ -n $fresh_project ]]; then
        _gssh_refresh_project "$fresh_project" \
            || { echo "Cannot refresh $fresh_project — check the project id, or run login_gcp."; return 1; }
    fi

    local instances picked gcp_instance gcp_zone gcp_project
    instances=$(_gssh_cached instances _gssh_list_instances) \
        || { echo "Cannot list instances — run login_gcp, then gssh -r."; return 1; }
    picked=$(sort -k3,3 -k2,2 -k1,1 -k4,4 <<< "$instances" | column -t | fzf -1 -e -q "$fresh_project" --prompt="Select instance: ")
    [[ -z $picked ]] && return 1
    read -r gcp_instance gcp_zone gcp_project _ <<< "$picked"

    local command_ssh="gcloud --project $gcp_project compute ssh $gcp_instance --zone $gcp_zone --tunnel-through-iap"
    echo $command_ssh && print -s "$command_ssh"
    eval $command_ssh
}

## -----  Login  -----

_login_vault_usage() {
    echo "Usage: login_vault [-t] [-l] [-r|-f] [-s|-a] [-h]"
    echo "  -t   Export VAULT_TOKEN after login"
    echo "  -l   List all stored tokens and exit"
    echo "  -r   Renew the current token"
    echo "  -f   Force re-authentication"
    echo "  -s   Select Vault instance interactively"
    echo "  -a   Login to all Vault instances"
    echo "  -h   Show this help message"
}

# Usage: _vault_login <force> <renew> — authenticate against $VAULT_ADDR.
_vault_login() {
    local force="$1" renew="$2" auth
    vault token lookup &>/dev/null
    auth=$?
    if [[ $force -eq 1 || $auth -ne 0 ]]; then
        echo "Reauthenticating with $VAULT_ADDR..."
        vault login -field=token -method=oidc -path={{ .org.vault.authPath }} role={{ .org.vault.authRole }}
    elif [[ $renew -eq 1 ]]; then
        echo "Renewing token with $VAULT_ADDR..."
        vault token renew
    else
        echo "Vault already logged in with $VAULT_ADDR!"
    fi
}

# Usage: login_vault [-h]
# OIDC login to Vault; defaults to the last instance in the list.
login_vault() {
    local force=0 all=0 renew=0 pick=0 settoken=0 option
    local vaults=(
{{- range .org.vault.addrs }}
        {{ . | quote }}
{{- end }}
    )
    local default_vault="${vaults[-1]}"

    while getopts "sraflth" option; do
        case $option in
            r) renew=1 ;;
            a) all=1 ;;
            f) force=1 ;;
            s) pick=1 ;;
            t) settoken=1 ;;
            l) vault-token-helper list -e; return $? ;;
            h) _login_vault_usage; return 0 ;;
            *) _login_vault_usage; return 1 ;;
        esac
    done

    if [[ $renew -eq 1 && $force -eq 1 ]]; then
        echo "Error: -r and -f options are mutually exclusive" && return 1
    elif [[ $pick -eq 1 && $all -eq 1 ]]; then
        echo "Error: -s and -a options are mutually exclusive" && return 1
    fi

    if [[ $pick -eq 1 ]]; then
        export VAULT_ADDR=$(printf "%s\n" "${vaults[@]}" | tac | fzf -1)
    elif [[ -z "$VAULT_ADDR" ]]; then
        export VAULT_ADDR="$default_vault"
    fi

    if [[ $all -eq 1 ]]; then
        local vault_addr
        for vault_addr in "${vaults[@]}"; do
            VAULT_ADDR="$vault_addr" _vault_login "$force" "$renew"
        done
    else
        _vault_login "$force" "$renew"
    fi

    if [[ $settoken -eq 1 ]]; then
        VAULT_TOKEN="$(vault token lookup --format json | jq -r '.data.id')"
        export VAULT_TOKEN
    fi
    vault-token-helper list -e
}

# stdout is noise, stderr is why the login failed — keep the latter.
login_az() {
    az login >/dev/null || { echo "az login failed."; return 1; }
}
login_aws() {
    aws sso login >/dev/null || { echo "aws sso login failed."; return 1; }
}
login_gcp() {
    gcloud auth login --brief --update-adc >/dev/null || { echo "gcloud auth login failed."; return 1; }
}
login_all() {
    login_aws && login_gcp
    login_vault -ra
}

## -----   Kube   -----
# Usage: kube-gk
# List generic-kube version per namespace
kube-gk() {
    local context=$(kubectl config get-contexts -o name| fzf -1 -e --prompt="Select kubernetes context: ")
    [[ -z $context ]] && return 1
    kubectl --context=$context get svc -A -o json | jq -r '.items[] | [(.metadata.labels["helm.sh/chart"] // "null"), .metadata.namespace, .metadata.name] | @tsv' | grep generic-kube | sort -k1,1 -V | column -t
}

## -----   Vault   -----
# Usage: vault_copy <src-kv-path> <dst-kv-path>
vault_copy() {
    local source=$1 dest=$2
    [[ -z "$source" || -z "$dest" ]] && { echo "Usage: vault_copy <src-kv-path> <dst-kv-path>"; return 1; }
    local data
    data=$(vault kv get -format=json "$source" | jq -r '.data.data') || return 1
    # Refuse to write jq's "null" over the destination when the source is empty.
    [[ -z "$data" || "$data" == "null" ]] && { echo "No data at $source — nothing copied."; return 1; }
    print -r -- "$data" | vault kv put "$dest" -
}
